// ====================
// ABONO
// ====================

model Abono {
  id         String   @id @default(cuid())
  numero     String   @unique
  facturaId  String
  factura    Factura  @relation(fields: [facturaId], references: [id])
  clienteId  String
  cliente    Cliente  @relation(fields: [clienteId], references: [id])
  negocioId  String?
  negocio    Negocio? @relation(fields: [negocioId], references: [id])
  pedidoId   String?
  pedido     Pedido?  @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  monto      Decimal  @db.Decimal(10, 2)
  metodoPago String
  fecha      DateTime @default(now()) @db.Timestamptz()

  createdAt DateTime @default(now()) @db.Timestamptz()

  @@index([facturaId])
  @@index([clienteId])
  @@index([negocioId])
  @@index([fecha])
  @@index([facturaId, fecha])
  @@index([pedidoId])
}

// ====================
// PRODUCCION
// ====================

model Produccion {
  id           String     @id @default(cuid())
  createdById  String?
  createdBy    User?      @relation("ProduccionCreador", fields: [createdById], references: [id])
  fecha        DateTime   @default(now()) @db.Timestamptz()
  turno        Turno
  trabajadorId String
  trabajador   Trabajador @relation(fields: [trabajadorId], references: [id])

  // Comisiones agregadas (la desagregación por producto está en ProduccionItem)
  comSellTotal   Decimal @default(0) @db.Decimal(10, 2)
  comRepartTotal Decimal @default(0) @db.Decimal(10, 2)

  obs String?

  // Offline-first dedup: si la request llega con un offlineId ya existente,
  // el server devuelve la Produccion existente en lugar de duplicar.
  offlineId String? @unique

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  items ProduccionItem[]

  @@unique([trabajadorId, fecha, turno])
  @@index([createdById])
  @@index([fecha])
  @@index([trabajadorId, fecha])
  @@index([turno, fecha])
}

model ProduccionItem {
  id           String     @id @default(cuid())
  produccionId String
  produccion   Produccion @relation(fields: [produccionId], references: [id], onDelete: Cascade)

  // Producto: solo PACA_AGUA y PACA_HIELO. Botellones y bolsas son
  // passthrough (no tienen ciclo de stock), por eso no se trackean
  // como items de producción.
  producto String // 'PACA_AGUA' | 'PACA_HIELO'

  // Conteos del sellador
  conteoA   Int @default(0)
  conteoB   Int @default(0)
  producido Int @default(0) // (A+B)/2 redondeado

  // Snapshot al momento del cierre
  stockIni Int @default(0)
  ventas   Int @default(0)

  // Resultado
  stockFinEsperado Int @default(0)
  stockFinFisico   Int @default(0)
  diferencia       Int @default(0) // stockFinEsperado - stockFinFisico - perdidasTotales

  // Pérdidas
  filtradas      Int @default(0)
  rotas          Int @default(0)
  consumoInterno Int @default(0)

  // Comisión del sellador por este item
  comSellador Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([produccionId, producto])
  @@index([producto])
}

// ====================
// GASTO
// ====================

model Gasto {
  id          String    @id @default(cuid())
  createdById String?
  createdBy   User?     @relation("GastoCreador", fields: [createdById], references: [id])
  fecha       DateTime  @default(now()) @db.Timestamptz()
  categoria   String
  descripcion String
  monto       Decimal   @default(0) @db.Decimal(10, 2)
  responsable String?
  notas       String?
  embarqueId  String?
  embarque    Embarque? @relation(fields: [embarqueId], references: [id])

  // Importación histórica: true si el gasto fue detectado como pago a personal
  // (nómina, sueldo, comisión, etc.) durante la importación.
  esPagoPersonal Boolean @default(false)

  // Importación histórica / gastos de nómina: vínculo al trabajador pagado.
  trabajadorId String?
  trabajador   Trabajador? @relation(fields: [trabajadorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([createdById])
  @@index([fecha])
  @@index([categoria, fecha])
  @@index([embarqueId])
  @@index([trabajadorId])
}

// ====================
// PROVEEDOR
// ====================

model Proveedor {
  id            String  @id @default(cuid())
  createdById   String?
  createdBy     User?   @relation("ProveedorCreador", fields: [createdById], references: [id])
  nombre        String
  nit           String? @unique
  telefono      String?
  email         String?
  direccion     String?
  tipoProducto  String? @db.VarChar(100)
  observaciones String? @db.Text
  activo        Boolean @default(true)

  insumos Insumo[]
  compras CompraInsumo[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([createdById])
}

// ====================
// INSUMO
// ====================

model Insumo {
  id          String  @id @default(cuid())
  createdById String?
  createdBy   User?   @relation("InsumoCreador", fields: [createdById], references: [id])
  nombre      String
  unidad      String
  stock       Decimal @default(0) @db.Decimal(10, 2)
  stockMin    Decimal @default(0) @db.Decimal(10, 2)
  precioUnit  Decimal @default(0) @db.Decimal(10, 2)
  activo      Boolean @default(true)

  proveedorId String?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])

  compras CompraInsumo[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([createdById])
}

// ====================
// COMPRA_INSUMO
// ====================

model CompraInsumo {
  id          String    @id @default(cuid())
  createdById String?
  createdBy   User?     @relation("CompraCreador", fields: [createdById], references: [id])
  numero      String    @unique
  proveedorId String
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id])
  insumoId    String
  insumo      Insumo    @relation(fields: [insumoId], references: [id])
  cantidad    Decimal   @db.Decimal(10, 2)
  montoTotal  Decimal   @db.Decimal(10, 2)
  fecha       DateTime  @default(now()) @db.Timestamptz()

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([createdById])
  @@index([fecha])
  @@index([insumoId])
  @@index([proveedorId])
}

// ====================
// PRODUCTO
// ====================

model Producto {
  id                  String  @id @default(cuid())
  codigo              String  @unique
  nombre              String
  descripcion         String?
  unidad              String
  contenido           String?
  activo              Boolean @default(true)
  aplicaDomicilio     Boolean @default(false)
  sobreCostoDomicilio Decimal @default(0) @db.Decimal(10, 2)
  precioBase          Decimal @default(0) @db.Decimal(10, 2)

  precios PrecioVolumen[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()
}

// ====================
// PRECIO_VOLUMEN
// ====================

model PrecioVolumen {
  id         String   @id @default(cuid())
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])

  cantMin Int     @default(1)
  cantMax Int?
  precio  Decimal @db.Decimal(10, 2)

  // Umbral minimo de alerta (commit 0c plan antifraude). Si el precio
  // de un item es < precioMinimo, la alerta PRECIO_POR_DEBAJO_TABLA
  // dispara. null = sin restriccion (alerta deshabilitada para esa fila).
  precioMinimo Decimal? @db.Decimal(10, 2)

  activo Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([productoId, cantMin])
  @@index([productoId])
  @@index([productoId, activo])
}

// ====================
// CONFIG
// ====================

model Config {
  id        String   @id @default(cuid())
  clave     String   @unique
  valor     String
  updatedAt DateTime @updatedAt @db.Timestamptz()
}

// ====================
// CIERRE_DIA
// ====================

model CierreDia {
  id    String   @id @default(cuid())
  fecha DateTime @unique @db.Timestamptz()

  numPedidos  Int     @default(0)
  totalVentas Decimal @default(0) @db.Decimal(10, 2)

  // Por origen (nuevos)
  totalVentaRapida Decimal @default(0) @db.Decimal(10, 2)
  totalPedido      Decimal @default(0) @db.Decimal(10, 2)
  totalVentaLibre  Decimal @default(0) @db.Decimal(10, 2)

  fiadoVentaRapida Decimal @default(0) @db.Decimal(10, 2)
  fiadoPedido      Decimal @default(0) @db.Decimal(10, 2)
  fiadoVentaLibre  Decimal @default(0) @db.Decimal(10, 2)

  aguaVendida       Int @default(0)
  hieloVendido      Int @default(0)
  botellonVendido   Int @default(0)
  bolsaAguaVendida  Int @default(0)
  bolsaHieloVendida Int @default(0)

  cobrado       Decimal @default(0) @db.Decimal(10, 2)
  fiado         Decimal @default(0) @db.Decimal(10, 2)
  efectivo      Decimal @default(0) @db.Decimal(10, 2)
  nequi         Decimal @default(0) @db.Decimal(10, 2)
  daviplata     Decimal @default(0) @db.Decimal(10, 2)
  transferencia Decimal @default(0) @db.Decimal(10, 2)
  bono          Decimal @default(0) @db.Decimal(10, 2)

  baseDia    Decimal @default(0) @db.Decimal(10, 2)
  comisiones Decimal @default(0) @db.Decimal(10, 2)
  salarios   Decimal @default(0) @db.Decimal(10, 2)
  gastos     Decimal @default(0) @db.Decimal(10, 2)

  stockIniAgua  Int @default(0)
  prodAgua      Int @default(0)
  stockFinAgua  Int @default(0)
  stockIniHielo Int @default(0)
  prodHielo     Int @default(0)
  stockFinHielo Int @default(0)

  netoCaja Decimal @default(0) @db.Decimal(10, 2)

  // Importación histórica: true si el cierre vino del papel/Excel viejo y
  // todavía no se verificó contra pedidos/pagos reales.
  necesitaValidacion Boolean @default(false)

  cerradoPor String?
  horaCierre DateTime? @db.Timestamptz()
  reporte    Json?

  createdAt DateTime @default(now()) @db.Timestamptz()
}

// ====================
// NOTA_CREDITO
// ====================

model NotaCredito {
  id        String   @id @default(cuid())
  numero    String   @unique
  pedidoId  String
  pedido    Pedido   @relation(fields: [pedidoId], references: [id])
  facturaId String?
  factura   Factura? @relation(fields: [facturaId], references: [id])
  monto     Decimal  @db.Decimal(10, 2)
  motivo    String
  fecha     DateTime @default(now()) @db.Timestamptz()
  creadoPor String?

  createdAt DateTime @default(now()) @db.Timestamptz()

  @@index([pedidoId])
  @@index([facturaId])
  @@index([fecha])
}

// ====================
// PUSH_SUBSCRIPTION (Web Push — commit 0d plan antifraude)
// ====================
//
// Almacena las suscripciones Web Push de los navegadores de los usuarios
// del sistema. Cuando se crea un Caso ALTA (alerta antifraude), el server
// itera sobre las suscripciones activas y manda un push via web-push.
//
// Estructura del endpoint segun W3C Web Push spec:
//   {
//     endpoint: 'https://fcm.googleapis.com/...',
//     keys: {
//       p256dh: '<base64url 65 bytes>',
//       auth: '<base64url 16 bytes>'
//     }
//   }
//
// El browser PUEDE renovar el endpoint (ej: chrome rota endpoints cada
// pocos meses para privacidad). Por eso el upsert es por endpoint+userId.

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("PushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  endpoint String   @unique
  p256dh   String
  auth     String

  // Metadata
  userAgent String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()
  lastSeenAt DateTime @default(now()) @db.Timestamptz()

  @@index([userId])
  @@index([lastSeenAt])
}

// ====================
// NOTIFICATION ROUTING
// ====================
// Sistema configurable de notificaciones push: por cada tipo de evento
// de negocio, un ADMIN elige qué roles y/o qué usuarios específicos
// reciben el aviso. Reemplaza el broadcastPush() sin filtrar (mandaba
// a TODAS las suscripciones activas sin importar rol/relevancia).

enum NotificationEventType {
  CLIENTE_CREADO
  PEDIDO_CREADO
  EMBARQUE_CERRADO
  PEDIDO_ENTREGADO
  PEDIDO_CULMINADO
  FIADO_GENERADO
  ABONO_APLICADO
  CIERRE_DIA_COMPLETADO
  GASTO_CREADO
  COMPRA_CREADA
  CASO_ALTA
}

model NotificationRule {
  id        String                @id @default(cuid())
  eventType NotificationEventType @unique
  enabled   Boolean               @default(true)
  roles     RolUsuario[]          @default([])

  targetUsers NotificationRuleTargetUser[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()
}

model NotificationRuleTargetUser {
  id     String           @id @default(cuid())
  ruleId String
  rule   NotificationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  userId String
  user   User             @relation("NotificationRuleTargetUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ruleId, userId])
  @@index([ruleId])
  @@index([userId])
}

// ====================
// HISTORIAL
// ====================

model Historial {
  id         String   @id @default(cuid())
  entidad    String
  registroId String
  accion     String
  datos      String
  usuarioId  String?
  fecha      DateTime @default(now()) @db.Timestamptz()

  @@index([entidad])
  @@index([fecha])
  @@index([usuarioId])
  @@index([entidad, registroId])
  @@index([entidad, fecha])
}

// ====================
// PRECIO_HISTORIAL
// ====================

model PrecioHistorial {
  id           String   @id @default(cuid())
  producto     String
  precio       Decimal  @db.Decimal(10, 2)
  vigenteDesde DateTime @default(now()) @db.Timestamptz()
  creadoPor    String

  createdAt DateTime @default(now()) @db.Timestamptz()
}

// ====================
// CASOS (Alert Resolution Workflow)
// ====================

model Caso {
  id          String  @id @default(cuid())
  alertaTipo  String
  severidad   String
  titulo      String
  descripcion String? @db.Text

  // Polimórfico: link al negocio. clienteId, pedidoId, negocioId y
  // repartidorId son mutuamente excluyentes (un caso es de UN sujeto).
  clienteId String?
  cliente   Cliente?  @relation("CasoCliente", fields: [clienteId], references: [id], onDelete: SetNull)
  negocioId String?
  negocio   Negocio?  @relation("CasoNegocio", fields: [negocioId], references: [id], onDelete: SetNull)
  pedidoId  String?
  pedido    Pedido?   @relation("CasoPedido", fields: [pedidoId], references: [id], onDelete: SetNull)
  repartidorId String?
  repartidor   Trabajador? @relation("CasoRepartidor", fields: [repartidorId], references: [id], onDelete: SetNull)

  // Workflow
  status      CasoStatus @default(ABIERTO)
  asignadoAId String?
  asignadoA   User?      @relation("CasoAsignado", fields: [asignadoAId], references: [id], onDelete: SetNull)
  creadoPorId String
  creadoPor   User       @relation("CasoCreador", fields: [creadoPorId], references: [id])

  // Resolución
  notasResolucion String?   @db.Text
  resueltoEn      DateTime? @db.Timestamptz()
  cerradoEn       DateTime? @db.Timestamptz()

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  eventos CasoEvento[]

  @@index([status])
  @@index([asignadoAId])
  @@index([clienteId])
  @@index([negocioId])
  @@index([pedidoId])
  @@index([repartidorId])
  @@index([alertaTipo])
  @@index([createdAt])
}

model CasoEvento {
  id         String   @id @default(cuid())
  casoId     String
  caso       Caso     @relation(fields: [casoId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("CasoEventoUser", fields: [userId], references: [id])
  accion     String
  valorPre   String?
  valorPost  String?
  comentario String?  @db.Text
  createdAt  DateTime @default(now()) @db.Timestamptz()

  @@index([casoId])
  @@index([createdAt])
}

// ====================
// DEUDA TRABAJADOR (prestamos, deficits)
// ====================

model DeudaTrabajador {
  id           String     @id @default(cuid())
  createdById  String?
  createdBy    User?      @relation("DeudaCreador", fields: [createdById], references: [id])
  trabajadorId String
  trabajador   Trabajador @relation(fields: [trabajadorId], references: [id])

  tipo           String // PRESTAMO, DEFICIT_EFECTIVO, ADELANTO_NOMINA, OTRO
  montoOriginal  Decimal @db.Decimal(10, 2)
  montoPendiente Decimal @db.Decimal(10, 2)

  // Plan de pago via nomina
  plazoNominas        Int?    // cuantas nominas se reparte (null = hasta pagar)
  porcentajePorNomina Int?    // tope % de la nomina a descontar por periodo (null = sin tope)

  embarqueId  String?
  descripcion String   @db.Text
  fecha       DateTime @default(now()) @db.Timestamptz()

  deducciones DeduccionDeuda[]
  abonos      AbonoDeuda[]
  createdAt   DateTime         @default(now()) @db.Timestamptz()
  updatedAt   DateTime         @updatedAt @db.Timestamptz()

  @@index([trabajadorId])
  @@index([trabajadorId, montoPendiente])
}

// ====================
// ABONO DEUDA (pagos parciales a deuda)
// ====================

model AbonoDeuda {
  id      String          @id @default(cuid())
  deudaId String
  deuda   DeudaTrabajador @relation(fields: [deudaId], references: [id], onDelete: Cascade)
  monto   Decimal         @db.Decimal(10, 2)
  fecha   DateTime        @default(now()) @db.Timestamptz()
  nota    String?         @db.Text

  @@index([deudaId])
}

// ====================
// DEDUCCION DEUDA (trazabilidad nomina -> deuda)
// ====================

model DeduccionDeuda {
  id        String          @id @default(cuid())
  nominaId  String
  nomina    Nomina          @relation(fields: [nominaId], references: [id])
  deudaId   String
  deuda     DeudaTrabajador @relation(fields: [deudaId], references: [id])
  monto     Decimal         @db.Decimal(10, 2)
  createdAt DateTime        @default(now()) @db.Timestamptz()

  @@unique([nominaId, deudaId])
  @@index([nominaId])
  @@index([deudaId])
}

// ====================
// MIGRACIÓN 1FN: ContactoCliente y PlantillaProducto (Fase 1 - EXPAND)
// ====================

model ContactoCliente {
  id        String  @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nombre    String
  telefono  String
  relacion  String?

  @@unique([clienteId, telefono])
  @@index([clienteId])
  @@index([telefono])
}

model PlantillaProducto {
  id          String              @id @default(cuid())
  plantillaId String
  plantilla   PlantillaRecurrente @relation(fields: [plantillaId], references: [id], onDelete: Cascade)
  producto    String
  cantidad    Int                 @default(0)

  @@unique([plantillaId, producto])
  @@index([plantillaId])
}

// ====================
// IMPORTACIÓN HISTÓRICA: zona de staging para carga masiva
// ====================

model ImportBatch {
  id        String            @id @default(cuid())
  createdById String
  createdBy   User            @relation("ImportBatchCreador", fields: [createdById], references: [id])
  nombre    String
  estado    ImportBatchEstado @default(DRAFT)

  totalRows        Int @default(0)
  autoMergedRows   Int @default(0)
  manualMergedRows Int @default(0)
  createdRows      Int @default(0)
  skippedRows      Int @default(0)
  errorRows        Int @default(0)

  reportJson Json?
  errorJson  Json?

  rows ImportStagingRow[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([createdById])
  @@index([estado])
}

model ImportStagingRow {
  id      String      @id @default(cuid())
  batchId String
  batch   ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  entity    ImportEntity
  rowNumber Int

  rawJson        Json
  normalizedJson Json?
  parseError     String?

  matchCandidates Json?
  decision        ImportDecision @default(PENDING)
  targetId        String? // id del registro canónico existente para merge
  createdId       String? // id del registro creado en commit
  error           String?

  contactos ImportStagingContacto[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([batchId])
  @@index([batchId, entity])
  @@index([batchId, decision])
}

model ImportStagingContacto {
  id           String           @id @default(cuid())
  stagingRowId String
  stagingRow   ImportStagingRow @relation(fields: [stagingRowId], references: [id], onDelete: Cascade)

  nombre   String
  telefono String
  relacion String?

  @@index([stagingRowId])
}
