generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ====================
// ENUMS
// ====================

enum EstadoPedido {
  PENDIENTE
  EN_RUTA
  ENTREGADO
  NO_ENTREGADO
  CANCELADO
  ANULADO
}

enum EstadoEntrega {
  PENDIENTE
  EN_RUTA
  ENTREGADO
  NO_ENTREGADO
  CANCELADO
  ANULADO
}

enum EstadoPago {
  PENDIENTE
  PARCIAL
  PAGADO
  ANTICIPADO
  VENCIDO
  ANULADO
}

enum OrigenPedido {
  PEDIDO
  VENTA_RAPIDA
  VENTA_LIBRE
  RECURRENTE
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  NEQUI
  DAVIPLATA
  BONO
}

enum RolUsuario {
  ADMIN
  ASISTENTE
  CONTADOR
  REPARTIDOR
  SELLADOR
  EMPACADOR
  ENTUBADOR
}

enum TipoPagoTrabajador {
  COMISION
  FIJO
  MIXTO
}

enum EstadoNomina {
  PENDIENTE
  PAGADA
  ANULADA
}

enum EstadoEmbarque {
  ABIERTO
  EN_RUTA
  CERRADO
  CANCELADO
}

// FASE 2 (ADR-STOCK-001, contrato §10): metadata de validación al crear una
// carga. NO representa stock físico ni infiere cuánto se cargó.
enum AvailabilityBasis {
  CONFIRMED_STOCK
  PRODUCTION_CONFIRMED
  ESTIMATED
  MIXED
}

// FASE 2 (ADR-FISICO-001, contrato §8): tipos de movimiento del ledger físico.
// El efecto se determina por el tipo, nunca por el signo de `cantidad`.
enum TipoMovimiento {
  CARGA
  RECARGA
  ENTREGA
  VENTA_RUTA
  RETORNO
  REEMPAQUE
  DESCARTE
  CUSTODY_TRANSFER
  PROMOCION
  AJUSTE_AUTORIZADO
}

// FASE 3 (ADR-OBLIGACION-001 / ADR-ACTIVIDAD-001, contrato §7):
enum ObligacionEstado {
  ABIERTA
  CUMPLIDA
  ANULADA
}

enum ActividadTipo {
  ENTREGA
  RECOGIDA_BOTELLON
  COBRO
}

enum ActividadEstado {
  ASIGNADA
  EN_PROGRESO
  CUMPLIDA
  CANCELADA
}

// FASE 6 (ADR-RESPONSABILIDAD-001, contrato §13):
enum ResponsibilityEstado {
  ABIERTA
  EN_INVESTIGACION
  RESUELTA_SIN_CARGO
  RESUELTA_CON_CARGO
  CERRADA
}

enum EstadoFactura {
  EMITIDA
  PAGADA
  ANULADA
  PARCIAL
}

enum Turno {
  MANANA
  TARDE
  NOCHE
}

enum CasoStatus {
  ABIERTO
  EN_PROCESO
  RESUELTO
  CERRADO
}

enum ImportBatchEstado {
  DRAFT
  ANALYZED
  COMMITTING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportEntity {
  CLIENTE
  PEDIDO
  PAGO
  EMBARQUE
  PRODUCCION
  GASTO
  CIERRE
  PROVEEDOR
  INSUMO
  COMPRA
  NOMINA
}

enum ImportDecision {
  PENDING
  AUTO_MERGE
  MANUAL_MERGE
  CREATE_NEW
  SKIP
}

// ====================
// USUARIOS
// ====================

model User {
  id                 String     @id @default(cuid())
  username           String     @unique
  password           String
  nombre             String     @default("")
  apellido           String     @default("")
  rol                RolUsuario @default(ASISTENTE)
  activo             Boolean    @default(true)
  mustChangePassword Boolean    @default(false)
  createdAt          DateTime   @default(now()) @db.Timestamptz()
  updatedAt          DateTime   @updatedAt @db.Timestamptz()

  trabajador Trabajador?

  clientesCreados     Cliente[]             @relation("ClienteCreador")
  pedidosCreados      Pedido[]              @relation("PedidoCreador")
  facturasCreadas     Factura[]             @relation("FacturaCreador")
  embarquesCreados    Embarque[]            @relation("EmbarqueCreador")
  gastosCreados       Gasto[]               @relation("GastoCreador")
  produccionesCreadas Produccion[]          @relation("ProduccionCreador")
  nominasCreadas      Nomina[]              @relation("NominaCreador")
  comprasCreadas      CompraInsumo[]        @relation("CompraCreador")
  insumosCreados      Insumo[]              @relation("InsumoCreador")
  proveedoresCreados  Proveedor[]           @relation("ProveedorCreador")
  trabajadoresCreados Trabajador[]          @relation("TrabajadorCreador")
  rutasCreadas        Ruta[]                @relation("RutaCreador")
  negociosCreados     Negocio[]             @relation("NegocioCreador")
  plantillasCreadas   PlantillaRecurrente[] @relation("PlantillaCreador")

  casosCreados   Caso[]       @relation("CasoCreador")
  casosAsignados Caso[]       @relation("CasoAsignado")
  eventosCaso    CasoEvento[] @relation("CasoEventoUser")

  pedidoItemsAutorizados PedidoItem[] @relation("PedidoItemAutorizador")

  // FASE 2 (ledger físico)
  movimientosAutorizados   EmbarqueMovimiento[] @relation("MovimientoAutorizador")
  sustitucionesAutorizadas Sustitucion[]        @relation("SustitucionAutorizador")

  // FASE 3 (obligaciones)
  ajustesAutorizados PedidoCantidadAjuste[] @relation("AjusteAutorizador")

  // FASE 6 (responsabilidad)
  responsibilityAutorizados ResponsibilityCase[] @relation("ResponsibilityAutorizador")
  responsibilityResueltos   ResponsibilityCase[] @relation("ResponsibilityResolutor")

  // FASE 8 (promociones)
  promotionsAutorizadas PromotionRule[] @relation("PromotionAutorizador")

  pushSubscriptions PushSubscription[] @relation("PushSubscriptions")

  notificationTargets NotificationRuleTargetUser[] @relation("NotificationRuleTargetUser")

  deudasCreadas DeudaTrabajador[] @relation("DeudaCreador")

  importBatchesCreadas ImportBatch[] @relation("ImportBatchCreador")

  // Session tracking for concurrent device limits (NOT NextAuth adapter Session table)
  sesionesActivas SesionActiva[]
}

// ====================
// SESIONES ACTIVAS (custom session tracking, NOT NextAuth adapter table)
// ====================

model SesionActiva {
  id          String     @id @default(cuid())
  usuarioId   String
  sessionId   String     @unique
  rol         RolUsuario
  userAgent   String?    @db.Text
  ip          String?
  dispositivo String?
  createdAt   DateTime   @default(now()) @db.Timestamptz()
  lastActive  DateTime   @default(now()) @db.Timestamptz()
  expiresAt   DateTime   @db.Timestamptz()

  usuario User @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, expiresAt])
  @@index([expiresAt])
  @@map("SesionActiva")
}

// ====================
// RUTA
// ====================

model Ruta {
  id          String  @id @default(cuid())
  createdById String?
  createdBy   User?   @relation("RutaCreador", fields: [createdById], references: [id])
  nombre      String
  dias        String?
  activo      Boolean @default(true)

  repartidorId         String?
  repartidor           Trabajador? @relation("RutaRepartidor", fields: [repartidorId], references: [id])
  repartidorRespaldoId String?
  repartidorRespaldo   Trabajador? @relation("RutaRespaldo", fields: [repartidorRespaldoId], references: [id])

  horarioInicio String?
  horarioFin    String?

  clientes  Cliente[]
  negocios  Negocio[]  @relation("RutaNegocio")
  embarques Embarque[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([createdById])
  @@index([repartidorId])
  @@index([repartidorRespaldoId])
}

// ====================
// CLIENTE
// ====================

model Cliente {
  id          String  @id @default(cuid())
  createdById String?
  createdBy   User?   @relation("ClienteCreador", fields: [createdById], references: [id])

  nombre        String
  apellido      String?
  telefono      String
  direccion     String?
  barrio        String?
  referencia  String?
  linkUbicacion String?

  // Geo coords — Bloque 1 (Ruta por Cercanía).
  // Backfilled desde linkUbicacion parseado, o desde mediana de
  // Pedido.gpsLat/gpsLng confirmados, o desde Negocio. `geocodeOrigen`
  // audita de dónde salieron las coords para que el admin pueda
  // revalidarlas si cambian.
  lat           Decimal? @db.Decimal(10, 6)
  lng           Decimal? @db.Decimal(10, 6)
  geocodeOrigen String?  // 'PARSED_URL' | 'GPS_HISTORIAL' | 'NEGOCIO' | 'MANUAL'
  geocodeAt     DateTime? @db.Timestamptz()

  // Bloque 3 (predicción de demanda) — auto-computado por cron diario.
  // `intervaloMediano` = días típicos entre pedidos (mediana).
  // `proxEsperada` = ultEntrega + intervaloMediano.
  // `diasAtraso` = hoy - proxEsperada (positivo = atrasado, llamar).
  // `scoreLlamada` = diasAtraso * pesoAtraso + valorTipico_norm * pesoValor.
  // `valorTipico` = promedio de los últimos 10 pedidos (moneda).
  // `scoreRecalculadoEn` = timestamp del último compute.
  // `ultimaLlamada` = timestamp del último "Marcar contactado".
  intervaloMediano    Int?
  proxEsperada        DateTime? @db.Timestamptz()
  diasAtraso          Int?
  scoreLlamada        Decimal?  @db.Decimal(8, 2)
  valorTipico         Decimal?  @db.Decimal(10, 2)
  scoreRecalculadoEn  DateTime? @db.Timestamptz()
  ultimaLlamada       DateTime? @db.Timestamptz()

  // FASE 3 CONTRACT: contactos legacy eliminada. Ahora es relación.
  contactos ContactoCliente[]

  // FASE 2 CONTRACT: campos legacy de negocio eliminados de Cliente.
  // Los datos fueron migrados a la tabla Negocio formal.
  fuente            String?
  preciosEspeciales String?

  rutaId String?
  ruta   Ruta?   @relation(fields: [rutaId], references: [id])

  frecuencia String @default("NINGUNA")
  cadaNDias  Int?

  ultEntrega  DateTime? @db.Timestamptz()
  proxEntrega DateTime? @db.Timestamptz()

  habAgua       Boolean @default(true)
  habHielo      Boolean @default(true)
  habBotellon   Boolean @default(true)
  habBolsaAgua  Boolean @default(true)
  habBolsaHielo Boolean @default(true)

  // NUEVOS — control y verificación
  verificado          Boolean    @default(false)
  verificadoEn        DateTime?  @db.Timestamptz()
  creadoPorRol        RolUsuario @default(ASISTENTE)
  bloqueado           Boolean    @default(false)
  reclamaciones       Int        @default(0)
  limitePedidosFiados Int?

  // NEGOCIOS — un cliente puede ser dueño de varios negocios
  negocios         Negocio[]
  negocioDefaultId String?   @unique
  negocioDefault   Negocio?  @relation("NegocioDefault", fields: [negocioDefaultId], references: [id])

  plantillaRecurrente PlantillaRecurrente?

  notas  String?
  activo Boolean @default(true)

  // FIX Fase 2 §3.4: saldo a favor del cliente. Si un pago excede el
  // total del pedido, el excedente queda como crédito reutilizable.
  // @default(0) garantiza que clientes existentes tengan 0.
  saldoFavor Decimal @default(0) @db.Decimal(10, 2)

  // Offline-first dedup: si la request llega con un offlineId ya existente,
  // el server devuelve el cliente creado en lugar de duplicar.
  offlineId String? @unique

  pedidos  Pedido[]
  facturas Factura[]
  abonos   Abono[]
  casos    Caso[]    @relation("CasoCliente")

  // FASE 3 (obligaciones)
  obligaciones ObligacionPendiente[]

  // FASE 5 (cartera)
  receivableEntries ReceivableEntry[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([rutaId])
  @@index([createdById])
  @@index([telefono])
  @@index([activo])
  @@index([barrio])
  @@index([frecuencia])
  @@index([proxEntrega])
  @@index([verificado])
  @@index([bloqueado])
  @@index([offlineId])
  // Geo: partial index (solo clientes con coords) para queries de clustering
  // y bounding box. WHERE lat IS NOT NULL reduce el tamaño del índice.
  @@index([lat, lng])
  // Bloque 3: índice para query "top N clientes con scoreLlamada más alto".
  @@index([scoreLlamada])
  @@index([diasAtraso])
  @@index([nombre])
}

// ====================
// NEGOCIO (sucursales de un cliente)
// ====================

model Negocio {
  id          String  @id @default(cuid())
  createdById String?
  createdBy   User?   @relation("NegocioCreador", fields: [createdById], references: [id])

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  nombre        String
  tipoNegocio   String?
  direccion     String? // si null, fallback a cliente.direccion
  barrio        String? // si null, fallback a cliente.barrio
  referencia    String?
  linkUbicacion String?

  // Geo coords — Bloque 1. Misma semántica que Cliente.lat/lng.
  // Si Negocio tiene coords propias, gana sobre Cliente. Si no, fallback a Cliente.
  lat           Decimal? @db.Decimal(10, 6)
  lng           Decimal? @db.Decimal(10, 6)

  horaApertura  String?

  rutaId String?
  ruta   Ruta?   @relation("RutaNegocio", fields: [rutaId], references: [id])

  preciosEspeciales String? // si null, fallback a cliente.preciosEspeciales

  habAgua       Boolean @default(true)
  habHielo      Boolean @default(true)
  habBotellon   Boolean @default(true)
  habBolsaAgua  Boolean @default(true)
  habBolsaHielo Boolean @default(true)

  frecuencia String?
  cadaNDias  Int?

  plantillaRecurrente PlantillaRecurrente?

  pedidos        Pedido[]
  facturas       Factura[]
  abonos         Abono[]
  casos          Caso[]    @relation("CasoNegocio")
  // Relation for Cliente.negocioDefault
  clienteDefault Cliente?  @relation("NegocioDefault")
  activo         Boolean   @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([clienteId])
  @@index([rutaId])
  @@index([activo])
  @@index([barrio])
}

// ====================
// PLANTILLA RECURRENTE
// ====================

model PlantillaRecurrente {
  id               String              @id @default(cuid())
  // NUEVO: relación principal a Negocio
  negocioId        String?             @unique
  negocio          Negocio?            @relation(fields: [negocioId], references: [id])
  // LEGACY: mantener para compatibilidad durante migración
  clienteId        String?             @unique
  cliente          Cliente?            @relation(fields: [clienteId], references: [id])
  activo           Boolean             @default(true)
  cadaNDias        Int                 @default(7)
  tipo             String              @default("ENVIO")
  canal           String   @default("DOMICILIO")
  horaPreferida   String?
  // FASE 3 CONTRACT: productos legacy eliminada. Ahora es relación.
  productos    PlantillaProducto[]
  ultimaGeneracion DateTime? @db.Timestamptz()
  proxGeneracion   DateTime?           @db.Timestamptz()
  saltos           String[]
  pausaHasta       DateTime?           @db.Timestamptz()
  notas            String?
  createdById      String?
  createdBy        User?               @relation("PlantillaCreador", fields: [createdById], references: [id])
  createdAt        DateTime            @default(now()) @db.Timestamptz()
  updatedAt        DateTime            @updatedAt @db.Timestamptz()

  @@index([activo, proxGeneracion])
  @@index([clienteId])
  @@index([negocioId])
}

// ====================
// TRABAJADOR
// ====================

model Trabajador {
  id          String             @id @default(cuid())
  createdById String?
  createdBy   User?              @relation("TrabajadorCreador", fields: [createdById], references: [id])
  userId      String?            @unique
  user        User?              @relation(fields: [userId], references: [id])
  nombre      String
  rol         String
  tipoPago    TipoPagoTrabajador @default(COMISION)

  usaMoto      Boolean @default(false)
  capacidadKg  Int     @default(500)
  comPacaAgua  Decimal @default(200) @db.Decimal(10, 2)
  comPacaHielo Decimal @default(200) @db.Decimal(10, 2)
  comBotellon  Decimal @default(200) @db.Decimal(10, 2)

  comRepartAgua     Decimal @default(0) @db.Decimal(10, 2)
  comRepartHielo    Decimal @default(0) @db.Decimal(10, 2)
  comRepartBotellon Decimal @default(0) @db.Decimal(10, 2)

  salarioFijo Decimal @default(0) @db.Decimal(10, 2)

  deudaReposAgua  Decimal @default(0) @db.Decimal(10, 2)
  deudaReposHielo Decimal @default(0) @db.Decimal(10, 2)
  telefono        String?
  activo          Boolean @default(true)

  embarques    Embarque[]
  producciones Produccion[]
  nominas      Nomina[]
  gastos       Gasto[]
  gpsTracks    GpsTrack[]
  descuentos   DescuentoRepartidor[]
  deudas       DeudaTrabajador[]

  // FASE 6 (responsabilidad)
  responsibilityCases ResponsibilityCase[]

  casosRepartidor Caso[] @relation("CasoRepartidor")

  rutasAsignadas Ruta[] @relation("RutaRepartidor")
  rutasRespaldo  Ruta[] @relation("RutaRespaldo")

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([createdById])
  @@index([rol, activo])
}

// ====================
// NOMINA
// ====================

model Nomina {
  id           String     @id @default(cuid())
  createdById  String?
  createdBy    User?      @relation("NominaCreador", fields: [createdById], references: [id])
  trabajadorId String
  trabajador   Trabajador @relation(fields: [trabajadorId], references: [id])

  fechaInicio DateTime @db.Timestamptz()
  fechaFin    DateTime @db.Timestamptz()

  entregasAgua     Int @default(0)
  entregasHielo    Int @default(0)
  entregasBotellon Int @default(0)

  comEntregasAgua     Decimal @default(0) @db.Decimal(10, 2)
  comEntregasHielo    Decimal @default(0) @db.Decimal(10, 2)
  comEntregasBotellon Decimal @default(0) @db.Decimal(10, 2)
  totalComisiones     Decimal @default(0) @db.Decimal(10, 2)

  // NUEVOS — comisiones por origen
  comVentaLibreAgua  Decimal @default(0) @db.Decimal(10, 2)
  comVentaLibreHielo Decimal @default(0) @db.Decimal(10, 2)
  comPedidoAgua      Decimal @default(0) @db.Decimal(10, 2)
  comPedidoHielo     Decimal @default(0) @db.Decimal(10, 2)

  salario Decimal @default(0) @db.Decimal(10, 2)
  total   Decimal @db.Decimal(10, 2)

  // Deducciones aplicadas
  totalDescuentos Decimal @default(0) @db.Decimal(10, 2)
  descuentoDeudas Decimal @default(0) @db.Decimal(10, 2)

  estado    EstadoNomina @default(PENDIENTE)
  fechaPago DateTime?    @db.Timestamptz()

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  descuentosAplicados DescuentoRepartidor[] @relation("NominaDescuentos")
  deduccionesDeudas   DeduccionDeuda[]

  @@index([createdById])
  @@index([trabajadorId])
  @@index([estado])
}

// ====================
// PEDIDO (con legacy + nuevos campos)
// ====================

model Pedido {
  id          String    @id @default(cuid())
  numero      Int       @default(autoincrement())
  createdById String?
  createdBy   User?     @relation("PedidoCreador", fields: [createdById], references: [id])
  clienteId   String
  cliente     Cliente   @relation(fields: [clienteId], references: [id])
  negocioId   String?
  negocio     Negocio?  @relation(fields: [negocioId], references: [id])
  embarqueId  String?
  embarque    Embarque? @relation(fields: [embarqueId], references: [id])

  tipo  String @default("ENVIO")
  canal String @default("DOMICILIO")

  fechaEntrega DateTime? @db.Timestamptz()
  fecha        DateTime  @default(now()) @db.Timestamptz()

  // NUEVOS — estado desacoplado
  origen        OrigenPedido  @default(PEDIDO)
  estadoEntrega EstadoEntrega @default(PENDIENTE)
  estadoPago    EstadoPago    @default(PENDIENTE)

  // Importación histórica: trazabilidad del origen (ej: IMPORTACION_HISTORICA)
  fuente String?

  // NUEVOS — control y trazabilidad
  promesaPagoFecha  DateTime? @db.Timestamptz()
  fotoEntrega       String?
  gpsLat            Decimal?  @db.Decimal(10, 6)
  gpsLng            Decimal?  @db.Decimal(10, 6)
  gpsAccuracy       Decimal?  @db.Decimal(10, 2)
  gpsJustificacion  String?   @db.Text
  entregadoConGps   Boolean   @default(true)
  entregadoAt       DateTime? @db.Timestamptz()
  adminOverrideNota String?   @db.Text
  adminOverrideBy   String?
  adminOverrideAt   DateTime? @db.Timestamptz()
  offlineId         String?   @unique
  recurrenteBatchId String? // batch id compartido por todos los pedidos de un batch de recurrentes
  // FIX Fase 1: dedup key dedicado para POST /api/pedidos/[id]/enviar.
  // Antes el dedup se hacia por estado (embarqueId+EN_RUTA), fragil si el
  // check externo y la tx se desincronizan. Ahora: el server persiste el
  // offlineId y el retry con el mismo offlineId retorna deduped: true.
  envioOfflineId    String?   @unique
  // FASE 1 (ADR-IDEMPOTENCIA-001, §14): claves idempotentes dedicadas por
  // comando reintentable offline. El retry con el mismo offlineId retorna
  // deduped:true sin re-ejecutar. Paridad con envioOfflineId (enviar).
  entregaOfflineId     String? @unique
  anulacionOfflineId   String? @unique
  cancelacionOfflineId String? @unique
  // FASE 7 (ADR-OFFLINE-001, contrato §11): timestamps de venta libre.
  // occurredAt = cuándo ocurrió la venta según el operador.
  // capturedAt = cuándo el dispositivo generó el registro local.
  // serverReceivedAt = cuándo llegó al servidor (server-side).
  // clasificacionTemporal = NORMAL | TARDIA | SOSPECHOSA (derivada del server).
  occurredAt           DateTime? @db.Timestamptz()
  capturedAt           DateTime? @db.Timestamptz()
  serverReceivedAt     DateTime? @db.Timestamptz()
  clasificacionTemporal String?
  disputaAbierta    Boolean   @default(false)
  codigoVisita      String?
  // Dirección de entrega puntual para ESTE pedido — null si no aplica
  // (se usa la dirección resuelta en vivo de negocio/cliente vía
  // pickDireccionTexto). Nunca modifica Cliente.direccion/barrio ni
  // Negocio.direccion/barrio; es un snapshot propio del pedido.
  direccionEntrega String?
  barrioEntrega    String?

  // LEGACY — se mantiene para compatibilidad
  estado EstadoPedido @default(PENDIENTE)

  // Productos embebidos (DEPRECATED — leer desde items[])
  cPacaAguaPed   Int     @default(0)
  cPacaAguaEnt   Int     @default(0)
  precioPacaAgua Decimal @default(0) @db.Decimal(10, 2)

  cPacaHieloPed   Int     @default(0)
  cPacaHieloEnt   Int     @default(0)
  precioPacaHielo Decimal @default(0) @db.Decimal(10, 2)

  cBotellonFabPed   Int     @default(0)
  cBotellonFabEnt   Int     @default(0)
  precioBotellonFab Decimal @default(0) @db.Decimal(10, 2)

  cBotellonDomPed   Int     @default(0)
  cBotellonDomEnt   Int     @default(0)
  precioBotellonDom Decimal @default(0) @db.Decimal(10, 2)

  cBolsaAguaPed   Int     @default(0)
  cBolsaAguaEnt   Int     @default(0)
  precioBolsaAgua Decimal @default(0) @db.Decimal(10, 2)

  cBolsaHieloPed   Int     @default(0)
  cBolsaHieloEnt   Int     @default(0)
  precioBolsaHielo Decimal @default(0) @db.Decimal(10, 2)

  // Totales
  total       Decimal @default(0) @db.Decimal(10, 2)
  totalPagado Decimal @default(0) @db.Decimal(10, 2)
  saldo       Decimal @default(0) @db.Decimal(10, 2)

  repartidor    String?
  obs           String?
  horaPreferida String?

  // Referencia polimórfica: PlantillaRecurrente.id o null
  idOrigen String?

  // Relaciones nuevas
  items PedidoItem[]

  factura      Factura?
  pagos        Pago[]
  notasCredito NotaCredito[]
  abonos       Abono[]
  casos        Caso[]        @relation("CasoPedido")

  // FASE 2 (ledger físico)
  sustituciones Sustitucion[]
  retornos      Retorno[]

  // FASE 3 (obligaciones)
  obligacion      ObligacionPendiente?
  ajustesCantidad PedidoCantidadAjuste[]

  // FASE 4 (recovery)
  recoveriesOrigen  RecoveryDecision[] @relation("RecoveryPedidoOrigen")
  recoveriesDestino RecoveryDecision[] @relation("RecoveryPedidoDestino")

  // FASE 5 (cartera)
  receivableEntries ReceivableEntry[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([clienteId])
  @@index([negocioId])
  @@index([embarqueId])
  @@index([fecha])
  @@index([estado])
  @@index([createdById])
  @@index([idOrigen])
  @@index([fecha, estado])
  @@index([clienteId, estado])
  @@index([estado, fecha])
  @@index([embarqueId, estado])
  @@index([canal, estado])
  @@index([fechaEntrega])
  // NUEVOS índices
  @@index([origen])
  @@index([estadoEntrega])
  @@index([estadoPago])
  @@index([offlineId])
  @@index([recurrenteBatchId])
  @@index([envioOfflineId])
  @@index([entregaOfflineId])
  @@index([anulacionOfflineId])
  @@index([cancelacionOfflineId])
  @@index([clienteId, estadoEntrega, estadoPago])
  @@index([promesaPagoFecha])
  @@index([numero])
  @@index([fecha, numero])
}

// ====================
// PEDIDO ITEM (nueva tabla normalizada)
// ====================

model PedidoItem {
  id       String @id @default(cuid())
  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  producto     String // PACA_AGUA, PACA_HIELO, BOTELLON, BOLSA_AGUA, BOLSA_HIELO
  cantPedido   Int     @default(0)
  cantEntrega  Int     @default(0)
  precio       Decimal @default(0) @db.Decimal(10, 2)
  subtotal     Decimal @default(0) @db.Decimal(10, 2)
  precioOrigen String  @default("base") // manual, cliente, volumen, base

  // commit 0c plan antifraude: cuando precioOrigen = 'manual', la alerta
  // CAMBIO_PRECIO_BRUSCO skipea SOLO si autorizadoPorAdmin = true. Sin
  // esta marca, cualquier precio manual es sospechoso (vector de fraude).
  autorizadoPorAdmin Boolean   @default(false)
  autorizadoPorId    String?
  autorizadoPor      User?     @relation("PedidoItemAutorizador", fields: [autorizadoPorId], references: [id], onDelete: SetNull)
  autorizadoEn       DateTime? @db.Timestamptz()

  @@index([pedidoId])
  @@index([producto])
}

// ====================
// PAGO
// ====================

model Pago {
  id        String     @id @default(cuid())
  pedidoId  String
  pedido    Pedido     @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  metodo    MetodoPago
  monto     Decimal    @db.Decimal(10, 2)
  // FIX LOW (C-VAL-8): offlineId actualmente es solo @index, no @unique.
  // Esto es por diseño: múltiples pagos del mismo batch offline comparten
  // offlineId para reconstruir el resumen "pagosAplicados" en el cliente.
  // Trade-off: si el cliente cambia el body de la request y reintenta
  // con el mismo offlineId, el server hace dedup y retorna los datos
  // del primer intento (data loss silencioso).
  //
  // Para hacerlo strict, se podría agregar @unique + un index en (pedidoId, offlineId),
  // pero eso requiere migración DB. Por ahora, se documenta el trade-off
  // y se confía en que el cliente no cambie el body entre reintentos.
  offlineId String? // batch id para dedup offline-first (pagos del mismo batch comparten offlineId)
  createdAt DateTime   @default(now()) @db.Timestamptz()

  @@index([pedidoId])
  @@index([offlineId])
}

// ====================
// EMBARQUE
// ====================

model Embarque {
  id           String         @id @default(cuid())
  createdById  String?
  createdBy    User?          @relation("EmbarqueCreador", fields: [createdById], references: [id])
  numero       Int            @default(autoincrement())
  numeroDia    Int            @default(0)
  fecha        DateTime       @default(now()) @db.Timestamptz()
  trabajadorId String
  trabajador   Trabajador     @relation(fields: [trabajadorId], references: [id])
  rutaId       String?
  ruta         Ruta?          @relation(fields: [rutaId], references: [id])
  horaSalida   DateTime?      @db.Timestamptz()
  horaLlegada  DateTime?      @db.Timestamptz()
  estado       EstadoEmbarque @default(ABIERTO)

  // Legacy — se mantiene para compatibilidad
  pacasAgua      Int @default(0)
  pacasHielo     Int @default(0)
  devueltasAgua  Int @default(0)
  devueltasHielo Int @default(0)
  rotasAgua      Int @default(0)
  rotasHielo     Int @default(0)

  // Tipo de motocarga
  tipoMoto String?

  // Dinero
  baseDinero      Decimal @default(0) @db.Decimal(10, 2)
  dineroEntregado Decimal @default(0) @db.Decimal(10, 2)

  // Snapshot de stock al crear
  stockSnapshot Json?

  // NUEVO — código de visita del día
  codigoVisita String?

  // Offline-first dedup: cada acción (update, cancel) escribe su offlineId aquí.
  // Si una request con el mismo offlineId llega de nuevo, el server detecta que
  // la acción ya fue aplicada y devuelve el estado actual sin re-aplicar.
  offlineId String?

  obs String?

  // Bloque 2: orden de visita optimizado por TSP heurístico (NN + 2-opt).
  // Array de {pedidoId, lat, lng, distanciaAcumulada, orden}.
  // Se persiste al llamar POST /api/embarques/[id]/optimizar-orden.
  // El repartidor ve la lista de pedidos en este orden en /repartidor.
  ordenVisita  Json?
  optimizadoEn DateTime?

  pedidos   Pedido[]
  gpsTracks GpsTrack[]
  productos EmbarqueProducto[]
  gastos    Gasto[]

  // FASE 2 (ledger físico)
  cargas        EmbarqueCarga[]
  movimientos   EmbarqueMovimiento[]
  sustituciones Sustitucion[]
  retornos      Retorno[]

  // FASE 3 (obligaciones)
  actividades Actividad[]

  // FASE 4 (recovery)
  recoveries RecoveryDecision[]

  // FASE 6 (responsabilidad)
  responsibilityCases ResponsibilityCase[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([trabajadorId, fecha, numeroDia], name: "embarque_trabajador_fecha_numeroDia_unique")
  @@index([createdById])
  @@index([trabajadorId])
  @@index([rutaId])
  @@index([fecha])
  @@index([estado])
  @@index([trabajadorId, fecha, numeroDia])
  @@index([offlineId])
  @@index([numero])
}

// ====================
// EMBARQUE PRODUCTO (conciliación por producto)
// ====================

model EmbarqueProducto {
  id         String   @id @default(cuid())
  embarqueId String
  embarque   Embarque @relation(fields: [embarqueId], references: [id], onDelete: Cascade)

  producto  String // PACA_AGUA, PACA_HIELO, BOTELLON, BOLSA_AGUA, BOLSA_HIELO
  cargadas  Int    @default(0)
  devueltas Int    @default(0)
  cambios   Int    @default(0)
  rotas     Int    @default(0)

  @@unique([embarqueId, producto])
  @@index([embarqueId])
}

// ====================
// LEDGER FÍSICO (FASE 2 — ADR-FISICO-001 / ADR-CUSTODIA-001 / ADR-STOCK-001)
// ====================
//
// `EmbarqueMovimiento` es el ledger físico canónico (contrato §8): `cantidad`
// es SIEMPRE positiva; el efecto se determina por `tipo`, nunca por el signo.
// `EmbarqueCargaProducto.cantidad` es el HECHO FÍSICO de la carga (cuánto se
// cargó). `EmbarqueCarga.availabilityBasis` es únicamente metadata de
// validación al crear la carga (contrato §10): NO representa stock físico y
// NUNCA infiere cuánto se cargó.

model EmbarqueCarga {
  id         String   @id @default(cuid())
  embarqueId String
  embarque   Embarque @relation(fields: [embarqueId], references: [id], onDelete: Cascade)

  // Snapshot del vehículo/capacidad al momento de la carga. No inventar
  // histórico (contrato §15): null si se desconoce.
  vehiculo    String?
  capacidadKg Int?

  // Metadata de validación (contrato §10). NO es inventario físico.
  availabilityBasis AvailabilityBasis @default(ESTIMATED)

  createdAt DateTime @default(now()) @db.Timestamptz()
  offlineId String?  @unique

  productos   EmbarqueCargaProducto[]
  movimientos EmbarqueMovimiento[]

  @@index([embarqueId])
  @@index([createdAt])
}

model EmbarqueCargaProducto {
  id      String        @id @default(cuid())
  cargaId String
  carga   EmbarqueCarga @relation(fields: [cargaId], references: [id], onDelete: Cascade)

  producto String
  // Hecho físico: unidades cargadas. Siempre positivo (CHECK constraint).
  cantidad Int

  @@unique([cargaId, producto])
  @@index([cargaId])
}

model EmbarqueMovimiento {
  id         String   @id @default(cuid())
  embarqueId String
  embarque   Embarque @relation(fields: [embarqueId], references: [id], onDelete: Cascade)
  cargaId    String?
  carga      EmbarqueCarga? @relation(fields: [cargaId], references: [id], onDelete: SetNull)

  tipo     TipoMovimiento
  producto String
  // Siempre positivo (CHECK constraint). El efecto es por `tipo` (contrato §8).
  cantidad Int

  // Custodia origen/destino (convención documentada: VEHICULO, ALMACEN,
  // INSPECCION, CLIENTE, PRODUCCION, DESCARTE, EXTERNO). Inequivoca (ADR-CUSTODIA-001).
  origen  String?
  destino String?

  // AJUSTE_AUTORIZADO exige metadata.effect (INCREASE|DECREASE) + authorization
  // + userId (contrato §8). Validado en servicio + CHECK constraint.
  metadata      Json?
  authorization String?
  userId        String?
  autorizador   User? @relation("MovimientoAutorizador", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz()
  offlineId String?  @unique

  retornos             Retorno[]     @relation("RetornoMovimiento")
  sustitucionRecepcion Sustitucion[] @relation("SustitucionRecepcion")
  sustitucionEntrega   Sustitucion[] @relation("SustitucionEntrega")
  recoveries           RecoveryDecision[]

  @@index([embarqueId])
  @@index([cargaId])
  @@index([tipo])
  @@index([origen])
  @@index([destino])
  @@index([createdAt])
}

model Sustitucion {
  id         String   @id @default(cuid())
  embarqueId String
  embarque   Embarque @relation(fields: [embarqueId], references: [id], onDelete: Cascade)
  pedidoId   String?
  pedido     Pedido?  @relation(fields: [pedidoId], references: [id], onDelete: SetNull)

  // Vincula los DOS hechos físicos separados (contrato §9): recepción de la
  // unidad defectuosa (RETORNO repartidor→inspección) + entrega de la unidad
  // de reemplazo (ENTREGA repartidor→cliente).
  movimientoRecepcionId String
  movimientoRecepcion   EmbarqueMovimiento @relation("SustitucionRecepcion", fields: [movimientoRecepcionId], references: [id], onDelete: Cascade)

  movimientoEntregaId String
  movimientoEntrega   EmbarqueMovimiento @relation("SustitucionEntrega", fields: [movimientoEntregaId], references: [id], onDelete: Cascade)

  autorizadoPorId String?
  autorizadoPor   User? @relation("SustitucionAutorizador", fields: [autorizadoPorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz()
  offlineId String?  @unique

  @@index([embarqueId])
  @@index([pedidoId])
}

model Retorno {
  id         String   @id @default(cuid())
  embarqueId String
  embarque   Embarque @relation(fields: [embarqueId], references: [id], onDelete: Cascade)
  pedidoId   String?
  pedido     Pedido?  @relation(fields: [pedidoId], references: [id], onDelete: SetNull)

  producto String
  cantidad Int     // positivo (CHECK constraint)
  motivo   String? // EMPAQUE_ROTO, PACA_FILTRADA, DEFECTUOSA, CLIENTE_RECHAZA, ...

  movimientoId String?
  movimiento   EmbarqueMovimiento? @relation("RetornoMovimiento", fields: [movimientoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz()
  offlineId String?  @unique

  @@index([embarqueId])
  @@index([pedidoId])
}

// ====================
// OBLIGACIONES Y ACTIVIDADES (FASE 3 — ADR-OBLIGACION-001 / ADR-ACTIVIDAD-001)
// ====================
//
// `ObligacionPendiente` (contrato §7): `cantidadDisponible` NO se almacena; es
// derivada = cantidadOriginal - cantidadCumplida - cantidadAsignada.
// Invariante (CHECK constraint): cantidadCumplida + cantidadAsignada <= original.
//
// `Actividad` (contrato §1): trabajo ejecutable; puede existir sin embarque.
// Máximo una asignación activa por obligación (partial unique index en SQL).

model ObligacionPendiente {
  id               String  @id @default(cuid())
  pedidoId         String? @unique
  pedido           Pedido? @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  clienteId        String?
  cliente          Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  producto         String
  cantidadOriginal Int
  cantidadCumplida Int     @default(0)
  cantidadAsignada Int     @default(0)
  estado           ObligacionEstado @default(ABIERTA)

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()
  offlineId String?  @unique

  actividades Actividad[]
  ajustes     PedidoCantidadAjuste[]

  @@index([pedidoId])
  @@index([clienteId])
  @@index([producto])
}

model Actividad {
  id           String  @id @default(cuid())
  obligacionId String
  obligacion   ObligacionPendiente @relation(fields: [obligacionId], references: [id], onDelete: Cascade)
  embarqueId   String?
  embarque     Embarque? @relation(fields: [embarqueId], references: [id], onDelete: SetNull)

  tipo             ActividadTipo  @default(ENTREGA)
  cantidad         Int
  cantidadCumplida Int            @default(0)
  estado           ActividadEstado @default(ASIGNADA)

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()
  offlineId String?  @unique

  @@index([obligacionId])
  @@index([embarqueId])
}

model PedidoCantidadAjuste {
  id           String @id @default(cuid())
  pedidoId     String
  pedido       Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  obligacionId String?
  obligacion   ObligacionPendiente? @relation(fields: [obligacionId], references: [id], onDelete: SetNull)

  producto         String
  cantidadOriginal Int
  cantidadNueva    Int
  delta            Int
  motivo           String
  autorizadoPorId  String
  autorizadoPor    User @relation("AjusteAutorizador", fields: [autorizadoPorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz()
  offlineId String?  @unique

  @@index([pedidoId])
  @@index([obligacionId])
}

// ====================
// RECOVERY (FASE 4 — ADR-RECUPERACION-001, contrato §3/§4)
// ====================
//
// `sourceEventId` y `cantidadDisponibleEnOrigen` son NULLABLES: un FALTANTE no
// tiene evento físico de origen consumible (contrato §3). Invariante:
// 0 <= cantidadAplicada <= cantidad (CHECK constraint).

model RecoveryDecision {
  id            String   @id @default(cuid())
  embarqueId    String
  embarque      Embarque @relation(fields: [embarqueId], references: [id], onDelete: Cascade)
  sourceEventId String?
  sourceEvent   EmbarqueMovimiento? @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)

  // SOBRANTE: cantidad disponible en el origen. FALTANTE: NULL (no hay origen).
  cantidadDisponibleEnOrigen Int?
  cantidad                   Int
  cantidadAplicada           Int
  // SOBRANTE | FALTANTE (contrato §3; validado por CHECK constraint).
  tipo     String
  producto String

  pedidoOrigenId  String?
  pedidoOrigen    Pedido? @relation("RecoveryPedidoOrigen", fields: [pedidoOrigenId], references: [id], onDelete: SetNull)
  pedidoDestinoId String?
  pedidoDestino   Pedido? @relation("RecoveryPedidoDestino", fields: [pedidoDestinoId], references: [id], onDelete: SetNull)

  // Snapshot del resultado de la decisión (APLICADA | PARCIAL | RECHAZADA).
  resultado      String
  actorId        String
  authorizedById String?
  reason         String

  createdAt DateTime @default(now()) @db.Timestamptz()
  offlineId String?  @unique

  @@index([embarqueId])
  @@index([sourceEventId])
  @@index([pedidoDestinoId])
  @@index([resultado])
}

// ====================
// RECEIVABLE ENTRY (FASE 5 — ADR-MONETARIO-001, contrato §12)
// ====================
//
// Proyección de auditoría DERIVADA de un Pago/Abono. NUNCA es una segunda
// fuente de verdad de la cartera: `Pedido.saldo`/`totalPagado` son canónicos.
// `saldoResultante` es un snapshot del saldo del pedido tras el hecho monetario,
// generado en la MISMA transacción (contrato §12).

model ReceivableEntry {
  id        String  @id @default(cuid())
  pedidoId  String?
  pedido    Pedido? @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  facturaId String?
  factura   Factura? @relation(fields: [facturaId], references: [id], onDelete: SetNull)
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  // PAGO | ABONO — tipo del hecho monetario que originó esta proyección.
  tipo  String
  monto Decimal @db.Decimal(10, 2)

  // Snapshot del estado del pedido tras el hecho (proyección, no fuente).
  saldoResultante       Decimal @db.Decimal(10, 2)
  totalPagadoResultante Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @db.Timestamptz()
  offlineId String?  @unique

  @@index([pedidoId])
  @@index([clienteId])
  @@index([facturaId])
}

// ====================
// RESPONSABILIDAD (FASE 6 — ADR-RESPONSABILIDAD-001, contrato §13)
// ====================
//
// La detección de una responsabilidad puede ser automática, pero la
// transferencia económica al trabajador NUNCA es automática: requiere un
// workflow de investigación → resolución. `RESUELTA_CON_CARGO` exige
// `autorizadoPorId` + `resueltoPorId` obligatorios. `embarqueId` es nullable
// porque una investigación puede ocurrir días después de la operación.

model ResponsibilityCase {
  id           String   @id @default(cuid())
  embarqueId   String?
  embarque     Embarque? @relation(fields: [embarqueId], references: [id], onDelete: SetNull)
  trabajadorId String?
  trabajador   Trabajador? @relation(fields: [trabajadorId], references: [id], onDelete: SetNull)

  // DISCREPANCIA_INVENTARIO | FALTANTE_CAJA | FIADO_NO_COBRADO
  tipo          String
  descripcion   String
  montoEstimado Decimal? @db.Decimal(10, 2)
  estado        ResponsibilityEstado @default(ABIERTA)

  // Resolución autorizada (§13): RESUELTA_CON_CARGO exige ambos.
  autorizadoPorId String?
  autorizadoPor   User? @relation("ResponsibilityAutorizador", fields: [autorizadoPorId], references: [id], onDelete: SetNull)
  resueltoPorId   String?
  resueltoPor     User? @relation("ResponsibilityResolutor", fields: [resueltoPorId], references: [id], onDelete: SetNull)
  resueltoAt      DateTime? @db.Timestamptz()

  // Hecho económico materializado SOLO tras resolución con cargo.
  hechoEconomicoId   String?
  hechoEconomicoTipo String? // DESCUENTO | DEUDA

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()
  offlineId String?  @unique

  @@index([embarqueId])
  @@index([trabajadorId])
  @@index([estado])
}

// ====================
// PROMOCIÓN (FASE 8 — ADR-PROMOCION-001 / ADR-AUTORIZACION-REGALOS-001, §17)
// ====================
//
// Un regalo/promoción autorizado consume inventario exactamente una vez y
// requiere autorización auditable. El consumo se registra en el ledger físico
// (EmbarqueMovimiento tipo PROMOCION), no como un cobro ficticio.

model PromotionRule {
  id        String  @id @default(cuid())
  nombre    String
  producto  String
  cantidad  Int     // unidades a regalar por aplicación
  activo    Boolean @default(true)

  autorizadoPorId String
  autorizadoPor   User @relation("PromotionAutorizador", fields: [autorizadoPorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz()
  offlineId String?  @unique

  @@index([producto])
  @@index([activo])
}

// ====================
// GPS TRACK (nueva)
// ====================

model GpsTrack {
  id           String   @id @default(cuid())
  embarqueId   String
  trabajadorId String
  lat          Decimal  @db.Decimal(10, 6)
  lng          Decimal  @db.Decimal(10, 6)
  accuracy     Decimal? @db.Decimal(10, 2)
  timestamp    DateTime @db.Timestamptz()
  synced       Boolean  @default(false)
  // FASE FINAL (ADR-IDEMPOTENCIA-001, §14): clave idempotente del comando
  // reintentable offline. Un retry con el mismo offlineId no duplica el track.
  offlineId    String?  @unique

  embarque   Embarque   @relation(fields: [embarqueId], references: [id])
  trabajador Trabajador @relation(fields: [trabajadorId], references: [id])

  @@index([embarqueId])
  @@index([trabajadorId, timestamp])
}

// ====================
// DESCUENTO REPARTIDOR (nueva)
// ====================

model DescuentoRepartidor {
  id               String   @id @default(cuid())
  embarqueId       String
  trabajadorId     String
  monto            Decimal  @db.Decimal(10, 2)
  motivo           String
  justificado      Boolean  @default(false)
  aplicadoEnNomina Boolean  @default(false)
  nominaId         String?
  fecha            DateTime @default(now()) @db.Timestamptz()

  trabajador Trabajador @relation(fields: [trabajadorId], references: [id])
  nomina     Nomina?    @relation("NominaDescuentos", fields: [nominaId], references: [id])

  @@index([trabajadorId])
  @@index([embarqueId])
  @@index([aplicadoEnNomina])
  @@index([nominaId])
}

// ====================
// FACTURA
// ====================

model Factura {
  id          String   @id @default(cuid())
  createdById String?
  createdBy   User?    @relation("FacturaCreador", fields: [createdById], references: [id])
  numero      String   @unique
  clienteId   String
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  negocioId   String?
  negocio     Negocio? @relation(fields: [negocioId], references: [id])
  pedidoId    String   @unique
  pedido      Pedido   @relation(fields: [pedidoId], references: [id])

  fecha    DateTime @default(now()) @db.Timestamptz()
  subtotal Decimal  @db.Decimal(10, 2)
  total    Decimal  @db.Decimal(10, 2)

  estado EstadoFactura @default(EMITIDA)

  montoPagado Decimal @default(0) @db.Decimal(10, 2)
  saldo       Decimal @db.Decimal(10, 2)

  // Snapshot de datos de empresa al momento de emisión (inmutable)
  empresaNombre    String? @default("Agua Bambú SAS")
  empresaNit       String? @default("900.123.456-7")
  empresaDireccion String? @default("")
  empresaTelefono  String? @default("")
  empresaEmail     String? @default("")

  abonos       Abono[]
  notasCredito NotaCredito[]

  // FASE 5 (cartera)
  receivableEntries ReceivableEntry[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([clienteId])
  @@index([negocioId])
  @@index([estado])
  @@index([createdById])
  @@index([saldo])
  @@index([fecha])
}

// ====================
// CHECK CONSTRAINTS via raw SQL migration
// ====================
// IMPORTANTE: Prisma Schema Language NO soporta CHECK constraints.
// Los siguientes viven en migraciones SQL raw, NO en este schema.
// Para ver/editar: `prisma/migrations/20260610_add_check_constraints/`.
//
// Auditoría pre-aplicación (2026-06-10): 0 violaciones en las 8 reglas
// principales. Datos limpios → aplicación directa con NOT VALID + VALIDATE.
//
// Aplicados en 20260610_add_check_constraints:
//   chk_pedido_saldo_nonneg          saldo >= 0
//   chk_pedido_montopagado_le_total  totalPagado <= total
//   chk_pedido_saldo_calc            saldo = total - totalPagado
//   chk_pedido_total_nonneg          total >= 0
//   chk_pago_monto_pos               monto > 0
//   chk_factura_saldo_nonneg         saldo >= 0
//   chk_factura_montopagado_le_total montoPagado <= total
//   chk_factura_total_nonneg         total >= 0
//   chk_abono_monto_pos              monto > 0
//
// Pendientes (no críticos para Fase 3):
//   chk_precio_cantmin / chk_precio_rango / chk_precio_positivo
//   chk_nomina_fechas
//   chk_trabajador_rol / chk_trabajador_capacidad
//   chk_embarque_pacas
//   chk_gasto_monto
//   chk_compra_cantidad / chk_compra_monto
//   chk_insumo_stockmin
//
// ====================
// SECUENCIA PARA Factura.numero (Fase 3 §2.3)
// ====================
// IMPORTANTE: NO aplicada aún. Gated por respuesta DIAN:
//   - Si permite huecos → aplicar 20260610_add_factura_numero_seq (secuencia)
//   - Si exige consecutivo sin huecos → NO aplicar; usar row-lock
//     (SELECT ... FOR UPDATE sobre una fila contadora) en su lugar.
//
// La migración crea la secuencia con START WITH = MAX(numero) + 1
// para no colisionar con facturas existentes. Cuando se confirme la
// decisión, además hay que actualizar src/lib/sequence.ts para que
// getNextNumero() use la secuencia cuando seqName = 'factura_numero_seq'.
// -- Pedido: totalPagado no puede exceder total, saldo no negativo
// -- Pedido: totalPagado no puede exceder total, saldo no negativo
// ALTER TABLE "Pedido" ADD CONSTRAINT chk_pedido_saldo CHECK ("saldo" >= 0);
// ALTER TABLE "Pedido" ADD CONSTRAINT chk_pedido_totalpagado CHECK ("totalPagado" <= "total");
//
// -- Pago y Abono: monto positivo
// ALTER TABLE "Pago" ADD CONSTRAINT chk_pago_monto CHECK ("monto" > 0);
// ALTER TABLE "Abono" ADD CONSTRAINT chk_abono_monto CHECK ("monto" > 0);
//
// -- Factura: saldo no negativo, montoPagado no excede total
// ALTER TABLE "Factura" ADD CONSTRAINT chk_factura_saldo CHECK ("saldo" >= 0);
// ALTER TABLE "Factura" ADD CONSTRAINT chk_factura_montopagado CHECK ("montoPagado" <= "total");
//
// -- PrecioVolumen: cantMin positivo, coherencia rangos
// ALTER TABLE "PrecioVolumen" ADD CONSTRAINT chk_precio_cantmin CHECK ("cantMin" > 0);
// ALTER TABLE "PrecioVolumen" ADD CONSTRAINT chk_precio_rango CHECK ("cantMax" IS NULL OR "cantMax" >= "cantMin");
// ALTER TABLE "PrecioVolumen" ADD CONSTRAINT chk_precio_positivo CHECK ("precio" > 0);
//
// -- Nomina: fechas coherentes
// ALTER TABLE "Nomina" ADD CONSTRAINT chk_nomina_fechas CHECK ("fechaFin" >= "fechaInicio");
//
// -- Trabajador: roles válidos
// ALTER TABLE "Trabajador" ADD CONSTRAINT chk_trabajador_rol CHECK ("rol" IN ('SELLADOR', 'REPARTIDOR', 'ADMIN', 'CONTADOR'));
// ALTER TABLE "Trabajador" ADD CONSTRAINT chk_trabajador_capacidad CHECK ("capacidadKg" > 0);
//
// -- Embarque: conteos no negativos
// ALTER TABLE "Embarque" ADD CONSTRAINT chk_embarque_pacas CHECK ("pacasAgua" >= 0 AND "pacasHielo" >= 0);
//
// -- Gasto: monto positivo
// ALTER TABLE "Gasto" ADD CONSTRAINT chk_gasto_monto CHECK ("monto" > 0);
//
// -- CompraInsumo: cantidades positivas
// ALTER TABLE "CompraInsumo" ADD CONSTRAINT chk_compra_cantidad CHECK ("cantidad" > 0);
