# Copiar a .env y ajustar valores locales:
#   cp .env.example .env
#
# .env* está en .gitignore — nunca commitear secretos reales.

# --- Base de datos (PostgreSQL, docker-compose local en el puerto 5433) ---
DATABASE_URL="postgresql://bambu:bambu_dev@localhost:5433/bambu"
DIRECT_URL="postgresql://bambu:bambu_dev@localhost:5433/bambu"

# --- Redis (rate limiting distribuido + pub/sub de realtime) ---
REDIS_URL="redis://localhost:6379"

# --- Auth.js v5 ---
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="reemplazar-con-openssl-rand--base64-32"
# Dejar SIN setear en dev (ver AGENTS.md issue #7): con AUTH_TRUST_HOST=true,
# Auth.js detecta el host del request y soporta localhost + LAN sin hardcodear.
# En producción (Vercel) SÍ debe apuntar al dominio público.
# NEXTAUTH_URL="https://tu-proyecto.vercel.app"
AUTH_TRUST_HOST="true"

# --- Dev LAN (opcional, para acceder desde otro dispositivo en la misma red) ---
# IP(s) LAN separadas por coma, habilita allowedDevOrigins en next.config.ts
# NEXT_PUBLIC_DEV_LAN_ORIGIN="192.168.1.100"

# --- Cron jobs (Vercel Cron envía Authorization: Bearer $CRON_SECRET) ---
CRON_SECRET="reemplazar-con-un-secreto-aleatorio"

# --- Push notifications (Web Push / VAPID) ---
# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# --- Negocio ---
# Días tras los cuales un fiado se considera vencido (default 7 si no se setea)
DIAS_VENCIMIENTO_FIADO="7"

# --- CORS (opcional, separado por comas) ---
# ALLOWED_ORIGINS="https://tu-dominio.com"

# --- Realtime rate limit (opcional, defaults razonables si no se setea) ---
# REALTIME_RATE_LIMIT_POINTS="6"
# REALTIME_RATE_LIMIT_DURATION_SEC="60"
# REALTIME_RATE_LIMIT_BLOCK_DURATION_SEC="300"

# --- Feature flags ---
# NEXT_PUBLIC_USE_RESILIENT_FETCH="true"
# NEXT_PUBLIC_REALTIME_ENABLED="true"

# --- Sentry (opcional) ---
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""

# --- Supabase (solo producción, si se usan features de Supabase más allá de Postgres) ---
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""
