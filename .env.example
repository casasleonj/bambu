# Agua Bambu v2 — variables de entorno
#
# cp .env.example .env
#
# Los valores de DATABASE_URL/REDIS_URL de abajo coinciden con
# docker-compose.yml (docker compose up -d) y con docker-entrypoint-initdb.d/
# 01-roles.sql — son credenciales de desarrollo local, ya públicas en ese
# archivo del propio repo, no secretos reales. En producción (Vercel +
# Supabase) estos valores se reemplazan por completo — ver AGENTS.md
# ("Deploy to Vercel + Supabase") para la tabla de variables de producción.

# ──────────────────────────────────────────────────────────────────────────
# Base de datos (PostgreSQL vía Docker Compose, puerto 5433)
# ──────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://app_write:bambu_app_write@localhost:5433/bambu"
DIRECT_URL="postgresql://app_write:bambu_app_write@localhost:5433/bambu"

# ──────────────────────────────────────────────────────────────────────────
# Redis (rate limiting + pub/sub de realtime, vía Docker Compose)
# ──────────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ──────────────────────────────────────────────────────────────────────────
# Auth.js (NextAuth v5)
# ──────────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="openssl rand -base64 32"
# NEXTAUTH_URL: dejar SIN SETEAR en dev (ver Known Issue #7 de AGENTS.md).
# Con AUTH_TRUST_HOST=true, Auth.js v5 detecta el host del request y
# soporta localhost + acceso LAN simultáneamente sin hardcodear nada.
# Si se setea, Auth.js usa ESE valor e ignora el host real del browser.
# NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Para acceder desde otro dispositivo en la misma red (LAN) durante dev:
# IP(s) LAN separadas por coma, usadas por next.config.ts (allowedDevOrigins)
# NEXT_PUBLIC_DEV_LAN_ORIGIN=""

# ──────────────────────────────────────────────────────────────────────────
# Feature flags (todas opcionales — ver src/lib/flags.ts)
# ──────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_PEDIDOS_V2="false"
# NEXT_PUBLIC_REALTIME_ENABLED="true"
# NEXT_PUBLIC_USE_RESILIENT_FETCH="true"
# NEXT_PUBLIC_PAGO_CONFIRMACION="false"
# NEXT_PUBLIC_VENTA_RUTA_ENTREGA_POSTERIOR="false"

# ──────────────────────────────────────────────────────────────────────────
# Rate limiting (opcional — ver src/lib/rate-limit.ts, valores por defecto
# razonables si se omiten)
# ──────────────────────────────────────────────────────────────────────────
# API_RATE_LIMIT_POINTS="300"
# API_RATE_LIMIT_DURATION_SEC="60"
# REALTIME_RATE_LIMIT_POINTS="6"
# REALTIME_RATE_LIMIT_DURATION_SEC="60"
# REALTIME_RATE_LIMIT_BLOCK_DURATION_SEC="300"

# ──────────────────────────────────────────────────────────────────────────
# Cron jobs (Vercel Cron) — requerido en producción para que los endpoints
# /api/cron/* acepten requests; en dev sin configurar, esos endpoints
# rechazan todas las requests (ver src/lib/cron-auth.ts)
# ──────────────────────────────────────────────────────────────────────────
# CRON_SECRET=""

# ──────────────────────────────────────────────────────────────────────────
# Opcional — límites de sesión por rol (override de defaults, JSON)
# Ver src/lib/session-limits.ts
# ──────────────────────────────────────────────────────────────────────────
# SESSION_LIMITS_JSON=""

# ──────────────────────────────────────────────────────────────────────────
# Opcional — días para considerar un pedido fiado vencido (default 7)
# Ver src/app/api/cron/generar-deudas-trabajador/route.ts
# ──────────────────────────────────────────────────────────────────────────
# DIAS_VENCIMIENTO_FIADO="7"

# ──────────────────────────────────────────────────────────────────────────
# Opcional — orígenes adicionales permitidos para CSRF (ver src/lib/csrf.ts)
# ──────────────────────────────────────────────────────────────────────────
# ALLOWED_ORIGINS=""

# ──────────────────────────────────────────────────────────────────────────
# Opcional — Supabase Storage (fotos de entrega). Sin configurar, el
# sistema cae a persistir la foto como base64 (ver src/lib/supabase.ts,
# src/lib/storage.ts)
# ──────────────────────────────────────────────────────────────────────────
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""

# ──────────────────────────────────────────────────────────────────────────
# Opcional — Web Push (notificaciones). Sin configurar, el hook cae al
# endpoint del servidor para obtener la clave pública
# (ver src/hooks/use-push-subscription.ts)
# ──────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:admin@example.com"

# ──────────────────────────────────────────────────────────────────────────
# Opcional — Sentry (error tracking)
# ──────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_DSN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""
